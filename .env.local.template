# Multi-Module Vite Environment Variables Template
# Copy this file to .env.local and add your actual values
# All Vite environment variables must start with VITE_

# === SUPABASE CONFIGURATION ===
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === GEMINI AI CONFIGURATION ===
# Get API key from: https://ai.google.dev/
# Dashboard module will use VITE_DASHBOARD_GEMINI_API_KEY if available,
# otherwise falls back to VITE_GEMINI_API_KEY
VITE_DASHBOARD_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_fallback_gemini_api_key_here

# === DASHBOARD MODULE CONFIGURATION ===
# Optional: Default database query parameters
VITE_DASHBOARD_DEFAULT_ORG_ID=your_default_org_id
VITE_DASHBOARD_DEFAULT_TIME_PERIOD=quarterly
VITE_DASHBOARD_REFRESH_INTERVAL=300000

# === OTHER MODULE CONFIGURATIONS ===
# Add environment variables for your other Vite modules here
# VITE_OTHER_MODULE_API_KEY=your_other_api_key
# VITE_ANOTHER_SERVICE_URL=https://your-service.com